# Supabase Configuration (Leave blank or set VITE_DEMO_MODE=true for local demo mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Demo Mode: When true, enables instant mock AI & offline storage without backend keys
VITE_DEMO_MODE=true

# Google Gemini API Key (multimodal vision screening)
# Note: In production, this is called securely via Supabase Edge Function / backend proxy
GEMINI_API_KEY=your_gemini_api_key_here
